# Open Food Facts requires no API key. This just sets a descriptive
# User-Agent as OFF's usage policy requests, and lets you swap the host
# (e.g. a self-hosted mirror) without touching code.
NEXT_PUBLIC_OFF_API_BASE=https://world.openfoodfacts.org
NEXT_PUBLIC_APP_NAME=NutriScore-IN
NEXT_PUBLIC_APP_CONTACT=support@example.com
